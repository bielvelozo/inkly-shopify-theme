<div class="site-header full-width" data-header>
  {% if section.settings.announcement != blank %}
    {%- assign messages = section.settings.announcement | split: '·' -%}
    <div class="announcement ribbon">
      <p class="visually-hidden">{{ section.settings.announcement }}</p>
      <div class="announcement__track" aria-hidden="true">
        {%- for copy in (1..8) -%}
          <div class="announcement__group">
            {%- for message in messages -%}
              <span class="announcement__item">{{ message | strip }}</span>
              <svg class="announcement__bow" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 12c-2.5-4.5-7.5-6-8.5-3.5S6 14 12 12Zm0 0c2.5-4.5 7.5-6 8.5-3.5S18 14 12 12Zm0 0-3 7m3-7 3 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {% endif %}

  <div class="site-header__bar">
    <header class="header">
      <details class="header__drawer">
        <summary class="header__icon" aria-label="{{ 'header.menu' | t }}">
          <span class="header__burger" aria-hidden="true"><span></span><span></span></span>
        </summary>
        <nav class="header__drawer-nav" aria-label="{{ 'header.menu' | t }}">
          {% for link in section.settings.menu.links %}
            <a
              href="{{ link.url }}"
              {% if link.current %}
                aria-current="page"
              {% endif %}
            >
              {{- link.title -}}
              {{ 'icon-arrow-right.svg' | inline_asset_content }}
            </a>
          {% endfor %}
        </nav>
      </details>

      <a class="header__logo" href="{{ routes.root_url }}">
        {%- if section.settings.logo -%}
          {{
            section.settings.logo
            | image_url: width: 400
            | image_tag: alt: shop.name, width: section.settings.logo_width, height: null, loading: 'eager'
          }}
        {%- else -%}
          <span class="header__wordmark">{{ shop.name | split: ' ' | first }}</span>
        {%- endif -%}
      </a>

      <nav class="header__menu" aria-label="{{ 'header.menu' | t }}">
        {% for link in section.settings.menu.links %}
          <a
            href="{{ link.url }}"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            {{- link.title -}}
          </a>
        {% endfor %}
      </nav>

      <div class="header__icons">
        {% if shop.customer_accounts_enabled %}
          <a class="header__icon header__account" href="{{ routes.account_url }}" aria-label="{{ 'header.account' | t }}">
            {{ 'icon-account.svg' | inline_asset_content }}
          </a>
        {% endif %}

        <a
          class="header__cart"
          href="{{ routes.cart_url }}"
          data-cart-toggle
          aria-label="{{ 'header.cart_count' | t: count: cart.item_count }}"
        >
          {{ 'icon-cart.svg' | inline_asset_content }}
          <span class="header__cart-label" aria-hidden="true">{{ 'header.cart' | t }}</span>
          <span class="header__cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>
            {{- cart.item_count -}}
          </span>
        </a>
      </div>
    </header>
  </div>
</div>

{% stylesheet %}
  .shopify-section:has(> .site-header) {
    position: sticky;
    z-index: 30;
    top: calc(-1 * var(--announcement-height, 0px));
  }

  .shopify-section:has(> .site-header .announcement) {
    --announcement-height: 2.5rem;
  }

  .announcement {
    display: flex;
    align-items: center;
    height: var(--announcement-height);
    overflow: hidden;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .announcement__track {
    display: flex;
    width: max-content;
    animation: marquee 38s linear infinite;
  }

  .announcement:hover .announcement__track {
    animation-play-state: paused;
  }

  .announcement__group {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-inline-end: 1.25rem;
  }

  .announcement__item {
    white-space: nowrap;
  }

  .announcement__bow {
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
    opacity: 0.85;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  .site-header__bar {
    padding: 0.75rem var(--page-margin);
  }

  .header {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem;
    max-width: calc(var(--page-width) - var(--page-margin) * 2);
    min-height: var(--header-height);
    margin-inline: auto;
    padding: 0.4rem 0.5rem 0.4rem 0.75rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.94);
    box-shadow: 0 1px 0 rgb(21 18 58 / 0.04), 0 8px 24px -14px rgb(21 18 58 / 0.3);
    transition: box-shadow 0.4s var(--ease-out), padding 0.4s var(--ease-out), min-height 0.4s var(--ease-out);
  }

  @supports (backdrop-filter: blur(1px)) {
    .header {
      background: rgb(255 255 255 / 0.82);
      backdrop-filter: blur(14px) saturate(1.4);
    }
  }

  .site-header.is-scrolled .header {
    min-height: calc(var(--header-height) - 0.5rem);
    box-shadow: 0 1px 0 rgb(21 18 58 / 0.05), 0 16px 34px -16px rgb(21 18 58 / 0.42);
  }

  .header__logo {
    grid-column: 2;
    justify-self: center;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .header__wordmark {
    display: block;
    font-family: var(--font-display--family);
    font-weight: 800;
    font-size: 1.55rem;
    line-height: 1;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  .header__logo img {
    width: auto;
    max-height: 2.4rem;
  }

  .header__menu {
    display: none;
  }

  .header__menu a {
    position: relative;
    padding: 0.55rem 0.95rem;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.25s ease;
  }

  .header__menu a:hover {
    background: var(--color-surface);
  }

  .header__menu a[aria-current='page'] {
    background: var(--color-lemon);
  }

  .header__icons {
    grid-column: 3;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.25rem;
  }

  .header__icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    color: var(--color-foreground);
    cursor: pointer;
    list-style: none;
    transition: background-color 0.25s ease;
  }

  .header__icon::-webkit-details-marker {
    display: none;
  }

  .header__icon:hover {
    background: var(--color-surface);
  }

  .header__icon svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  .header__account {
    display: none;
  }

  .header__burger {
    display: grid;
    gap: 5px;
    width: 1.25rem;
  }

  .header__burger span {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: currentcolor;
    transition: transform 0.35s var(--ease-out);
  }

  .header__drawer[open] .header__burger span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .header__drawer[open] .header__burger span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .header__cart {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.9rem;
    padding: 0 0.95rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.28);
    transition: transform 0.35s var(--ease-spring);
  }

  .header__cart:hover {
    transform: translateY(-1px);
  }

  .header__cart svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .header__cart-label {
    display: none;
  }

  .header__cart-count {
    display: grid;
    place-items: center;
    min-width: 1.4rem;
    height: 1.4rem;
    padding: 0 0.35rem;
    border-radius: 999px;
    background: var(--color-lemon);
    color: var(--color-foreground);
    font-size: 0.78rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .header__cart-count[hidden] {
    display: none;
  }

  .header__cart-count.is-bumped {
    animation: count-bump 0.6s var(--ease-spring);
  }

  @keyframes count-bump {
    40% {
      transform: scale(1.45) rotate(-8deg);
    }
  }

  .header__drawer {
    grid-column: 1;
    grid-row: 1;
    justify-self: start;
  }

  .header__drawer-nav {
    position: absolute;
    z-index: 20;
    top: calc(100% + 0.6rem);
    left: 0;
    right: 0;
    display: grid;
    padding: 0.75rem;
    border-radius: 1.75rem;
    background: var(--color-background);
    box-shadow: var(--shadow-lift);
    animation: sheet-in 0.45s var(--ease-out);
  }

  .header__drawer-nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.95rem 1rem;
    border-radius: 1.1rem;
    font-family: var(--font-display--family);
    font-weight: 800;
    font-size: 1.35rem;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .header__drawer-nav a:nth-child(4n + 1):hover,
  .header__drawer-nav a:nth-child(4n + 1)[aria-current='page'] {
    background: var(--color-pink);
  }

  .header__drawer-nav a:nth-child(4n + 2):hover,
  .header__drawer-nav a:nth-child(4n + 2)[aria-current='page'] {
    background: var(--color-lemon);
  }

  .header__drawer-nav a:nth-child(4n + 3):hover,
  .header__drawer-nav a:nth-child(4n + 3)[aria-current='page'] {
    background: var(--color-mint);
  }

  .header__drawer-nav a:nth-child(4n):hover,
  .header__drawer-nav a:nth-child(4n)[aria-current='page'] {
    background: var(--color-surface);
  }

  .header__drawer-nav svg {
    width: 1.3rem;
    height: 1.3rem;
  }

  @keyframes sheet-in {
    from {
      opacity: 0;
      transform: translateY(-0.6rem) scale(0.98);
    }
  }

  @media (min-width: 990px) {
    .header {
      grid-template-columns: auto 1fr auto;
      gap: 1.5rem;
      padding-left: 1.6rem;
    }

    .header__logo {
      grid-column: 1;
    }

    .header__drawer {
      display: none;
    }

    .header__menu {
      grid-column: 2;
      display: flex;
      justify-content: center;
      gap: 0.15rem;
    }

    .header__account {
      display: grid;
    }

    .header__cart-label {
      display: inline;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "text",
      "id": "announcement",
      "label": "t:labels.announcement",
      "info": "t:info.announcement"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 60,
      "max": 240,
      "step": 10,
      "unit": "px",
      "label": "t:labels.logo_width",
      "default": 120
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
