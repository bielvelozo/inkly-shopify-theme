{% doc %}
  Suggests up to three products from the theme setting, skipping what is
  already in the cart and what is sold out. Products that need options or
  personalization link to their page instead of adding straight away.
{% enddoc %}

{%- liquid
  assign heading = settings.cart_upsell_heading
  if heading == blank
    assign heading = 'cart.upsell_heading_default' | t
  endif
  assign shown = 0
-%}

{% capture upsell_items %}
  {%- for product in settings.cart_upsell_products -%}
    {%- liquid
      if shown >= 3
        break
      endif
      unless product.available
        continue
      endunless
      assign in_cart = false
      for item in cart.items
        if item.product_id == product.id
          assign in_cart = true
          break
        endif
      endfor
      if in_cart
        continue
      endif
      assign shown = shown | plus: 1
      assign variant = product.selected_or_first_available_variant
      assign item_id = variant.sku | default: variant.id
      assign variant_price = variant.price | divided_by: 100.0
    -%}
    {%- capture analytics -%}
      {"item_id": {{ item_id | json }}, "item_name": {{ product.title | json }}, "price": {{ variant_price | json }}, "item_list_name": "cart_upsell", "index": {{ shown }}}
    {%- endcapture -%}
    <li class="cart-upsell__item" data-upsell-item="{{ analytics | strip | escape }}">
      <a class="cart-upsell__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
        {%- if product.featured_image -%}
          {{ product.featured_image | image_url: width: 200 | image_tag: width: 100, height: 100, loading: 'lazy', alt: '' }}
        {%- endif -%}
      </a>
      <div class="cart-upsell__details">
        <a class="cart-upsell__title" href="{{ product.url }}">{{ product.title }}</a>
        {% render 'price', variant: variant %}
      </div>
      {%- if product.has_only_default_variant and product.template_suffix != 'personalizado' -%}
        <form action="{{ routes.cart_add_url }}" method="post">
          <input type="hidden" name="id" value="{{ variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <input type="hidden" name="return_to" value="{{ routes.cart_url }}">
          <button
            type="submit"
            class="button button--secondary button--small"
            data-upsell-add
            data-variant-id="{{ variant.id }}"
            aria-label="{{ 'cart.upsell_add_label' | t: product: product.title | escape }}"
          >
            {{- 'cart.upsell_add' | t -}}
          </button>
        </form>
      {%- else -%}
        <a class="button button--secondary button--small" href="{{ product.url }}">{{ 'cart.upsell_choose' | t }}</a>
      {%- endif -%}
    </li>
  {%- endfor -%}
{% endcapture %}

{% if shown > 0 %}
  <section class="cart-upsell" aria-labelledby="CartUpsellHeading">
    <h3 class="cart-upsell__heading" id="CartUpsellHeading">{{ heading }}</h3>
    <ul class="cart-upsell__list" role="list">
      {{ upsell_items }}
    </ul>
  </section>
{% endif %}
