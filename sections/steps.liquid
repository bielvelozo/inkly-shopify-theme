<div class="steps section-spacing">
  <h2 class="steps__heading" data-aos="fade-up">{{ section.settings.heading }}</h2>
  <div class="steps__list">
    {% for block in section.blocks %}
      {%- liquid
        case block.settings.icon
          when 'edit'
            assign icon = 'fa-pen-nib'
          when 'box'
            assign icon = 'fa-box-open'
          when 'heart'
            assign icon = 'fa-heart'
          else
            assign icon = 'fa-hand-pointer'
        endcase
      -%}
      <div class="steps__item" data-aos="zoom-in" data-aos-delay="{{ forloop.index | times: 200 }}" {{ block.shopify_attributes }}>
        <i class="fa-solid {{ icon }} fa-2x"></i>
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.text }}</p>
      </div>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .steps__heading {
    text-align: center;
  }

  .steps__list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .steps__item {
    padding: 2rem;
    border-radius: 20px;
    background: #fff;
    text-align: center;
  }

  .steps__item i {
    color: #e8643c;
  }

  .steps__item h3 {
    margin-top: 1rem;
  }

  .steps__item p {
    margin-top: 0.5rem;
    color: #b0a99f;
  }

  @media (max-width: 749px) {
    .steps__list {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.steps",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:general.step",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:labels.icon",
          "options": [
            { "value": "pick", "label": "t:options.icon.pick" },
            { "value": "edit", "label": "t:options.icon.edit" },
            { "value": "box", "label": "t:options.icon.box" },
            { "value": "heart", "label": "t:options.icon.heart" }
          ],
          "default": "pick"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:labels.text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.steps"
    }
  ]
}
{% endschema %}
