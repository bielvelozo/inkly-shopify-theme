<script src="{{ 'carousel.js' | asset_url }}" defer></script>

<div class="testimonials section-spacing">
  <scroll-carousel class="testimonials__carousel">
    <div class="testimonials__header">
      <h2>{{ section.settings.heading }}</h2>
      <div class="testimonials__controls">
        <button type="button" class="testimonials__control" data-prev aria-label="{{ 'sections.testimonials.previous' | t }}">
          {{- 'icon-chevron-left.svg' | inline_asset_content -}}
        </button>
        <button type="button" class="testimonials__control" data-next aria-label="{{ 'sections.testimonials.next' | t }}">
          {{- 'icon-chevron-right.svg' | inline_asset_content -}}
        </button>
      </div>
    </div>

    <ul class="testimonials__track" role="list" data-track>
      {% for block in section.blocks %}
        <li class="testimonials__card" {{ block.shopify_attributes }}>
          <p class="testimonials__stars" role="img" aria-label="{{ 'sections.testimonials.rating' | t: rating: block.settings.rating }}">
            {%- for i in (1..block.settings.rating) -%}
              {{ 'icon-star.svg' | inline_asset_content }}
            {%- endfor -%}
          </p>
          <blockquote class="testimonials__quote">“{{ block.settings.quote }}”</blockquote>
          <p class="testimonials__author">{{ block.settings.author }} · {{ block.settings.location }}</p>
        </li>
      {% endfor %}
    </ul>
  </scroll-carousel>
</div>

{% stylesheet %}
  .testimonials__carousel {
    display: grid;
    gap: 2rem;
  }

  .testimonials__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .testimonials__controls {
    display: flex;
    gap: 0.5rem;
  }

  .testimonials__control {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1.5px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-surface);
    cursor: pointer;
  }

  .testimonials__control:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .testimonials__control svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  .testimonials__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(85%, 22rem);
    gap: 1.25rem;
    margin: 0;
    padding: 0 0 0.5rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    list-style: none;
  }

  .testimonials__track::-webkit-scrollbar {
    display: none;
  }

  .testimonials__card {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: 1.75rem;
    border-radius: 20px;
    background: var(--color-surface);
    scroll-snap-align: start;
  }

  .testimonials__stars {
    display: flex;
    gap: 0.15rem;
    color: #c98a0b;
  }

  .testimonials__stars svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .testimonials__quote {
    margin: 0;
    font-size: 1.05rem;
  }

  .testimonials__author {
    color: var(--color-muted);
    font-size: 0.9rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "t:general.testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "t:labels.quote"
        },
        {
          "type": "text",
          "id": "author",
          "label": "t:labels.author"
        },
        {
          "type": "text",
          "id": "location",
          "label": "t:labels.location"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "t:labels.rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.testimonials"
    }
  ]
}
{% endschema %}
