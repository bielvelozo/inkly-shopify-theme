<div class="hero full-width">
  {% if section.settings.image %}
    {{
      section.settings.image
      | image_url: width: 2400
      | image_tag:
        widths: '600, 900, 1200, 1600, 2000, 2400',
        sizes: '100vw',
        loading: 'eager',
        fetchpriority: 'high',
        preload: true,
        class: 'hero__image',
        alt: section.settings.image.alt
    }}
  {% endif %}

  <div class="hero__inner">
    <h1 class="hero__title">{{ section.settings.heading }}</h1>
    <p class="hero__text">{{ section.settings.subheading }}</p>
    {% if section.settings.button_label != blank %}
      <a class="button hero__button" href="{{ section.settings.button_link }}">
        {{ section.settings.button_label }}
        {{ 'icon-arrow-right.svg' | inline_asset_content }}
      </a>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .hero {
    display: grid;
    min-height: min(82vh, 52rem);
    background: #f1ebe2;
  }

  .hero > * {
    grid-area: 1 / 1;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
  }

  .hero__inner {
    z-index: 1;
    align-self: center;
    width: min(36rem, 100%);
    padding: 4rem var(--page-margin);
    margin-inline-start: max(var(--page-margin), calc((100% - var(--page-width)) / 2));
  }

  .hero__title {
    font-size: clamp(2.6rem, 1.6rem + 4vw, 4.25rem);
    line-height: 1.02;
  }

  .hero__text {
    margin-top: 1.25rem;
    font-size: clamp(1.05rem, 1rem + 0.4vw, 1.25rem);
    color: var(--color-muted);
  }

  .hero__button {
    margin-top: 2rem;
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .hero__button svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  @media (max-width: 749px) {
    .hero {
      align-content: start;
    }

    .hero__inner {
      align-self: start;
      margin-inline-start: 0;
      padding-top: 2.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:labels.subheading"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    }
  ],
  "presets": [
    {
      "name": "t:general.hero"
    }
  ]
}
{% endschema %}
