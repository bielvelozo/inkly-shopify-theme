{{ 'section-build-notes.css' | asset_url | stylesheet_tag }}

<div class="build-maker section-spacing" id="who-built-it">
  <div class="build-maker__card paper paper--cobalt">
    {% if section.settings.tag != blank %}
      <p class="tag tag--lemon build-maker__tag">{{ section.settings.tag }}</p>
    {% endif %}
    <h2 class="build-maker__title">{{ section.settings.heading }}</h2>
    {% if section.settings.text != blank %}
      <div class="build-maker__text">{{ section.settings.text }}</div>
    {% endif %}
    {% if section.blocks.size > 0 %}
      <ul class="build-maker__links" role="list">
        {% for block in section.blocks %}
          <li {{ block.shopify_attributes }}>
            <a
              class="button build-maker__link{% if block.settings.style == 'secondary' %} button--secondary{% else %} build-maker__link--primary{% endif %}"
              href="{{ block.settings.url }}"
              target="_blank"
              rel="noopener"
            >
              <span class="build-maker__label">
                {{- block.settings.label -}}
                {% if block.settings.note != blank %}
                  <span class="build-maker__note">{{ block.settings.note }}</span>
                {% endif %}
              </span>
              {{ 'icon-arrow-right.svg' | inline_asset_content }}
            </a>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "t:general.build_maker",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "t:labels.tag"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "t:general.maker_link",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:labels.link_label"
        },
        {
          "type": "text",
          "id": "note",
          "label": "t:labels.note"
        },
        {
          "type": "url",
          "id": "url",
          "label": "t:labels.link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "t:labels.style",
          "options": [
            { "value": "primary", "label": "t:options.button_style.primary" },
            { "value": "secondary", "label": "t:options.button_style.secondary" }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.build_maker"
    }
  ]
}
{% endschema %}
