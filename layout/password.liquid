<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    {{ content_for_layout }}

    {% # iOS Safari only paints :active press states while the page has a touchstart listener; this layout skips theme.js. %}
    <script>
      document.addEventListener('touchstart', () => {}, { passive: true });
    </script>
  </body>
</html>
