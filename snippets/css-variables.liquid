{% doc %}
  Fonts and design tokens, inlined in <head>.

  @param {boolean} [body_font_bundled] - The body font is the default Archivo,
    served from the theme as static 400 and 700 instances (16 KB each) instead
    of the 45 KB variable files of the Shopify font library
{% enddoc %}

{%- assign body_font = settings.type_primary_font -%}

{% style %}
  {%- if body_font_bundled -%}
    @font-face {
      font-family: Archivo;
      src: url('{{ 'archivo-400.woff2' | asset_url }}') format('woff2');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }

    @font-face {
      font-family: Archivo;
      src: url('{{ 'archivo-700.woff2' | asset_url }}') format('woff2');
      font-weight: 700;
      font-style: normal;
      font-display: swap;
    }
  {%- else -%}
    {{ body_font | font_face: font_display: 'swap' }}
    {{ body_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {%- endif %}

  @font-face {
    font-family: 'Inkly Display';
    src: url('{{ 'archivo-expanded-800.woff2' | asset_url }}') format('woff2');
    font-weight: 800;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Inkly Display Fallback';
    src: local('Arial Black'), local('Arial Bold'), local('Helvetica Neue Bold');
    size-adjust: 104%;
    ascent-override: 88%;
    descent-override: 22%;
  }

  :root {
    --font-primary--family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-primary--style: {{ settings.type_primary_font.style }};
    --font-primary--weight: {{ settings.type_primary_font.weight }};
    --font-display--family: 'Inkly Display', 'Inkly Display Fallback', sans-serif;
    --page-width: {{ settings.max_page_width }};
    --page-margin: max({{ settings.min_page_margin }}px, 4vw, env(safe-area-inset-left, 0px), env(safe-area-inset-right, 0px));
    --color-background: {{ settings.background_color }};
    --color-surface: {{ settings.surface_color }};
    --color-foreground: {{ settings.foreground_color }};
    --color-muted: {{ settings.muted_color }};
    --color-accent: {{ settings.accent_color }};
    --color-accent-ink: #fff;
    --color-border: {{ settings.border_color }};
    --color-pink: {{ settings.paper_pink }};
    --color-lemon: {{ settings.paper_lemon }};
    --color-mint: {{ settings.paper_mint }};
    --color-success: #12784a;
    --color-danger: #c4213b;
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
    --radius-card: 1.5rem;
    --radius-tag: 0.6rem;
    --shadow-soft: none;
    --shadow-lift: none;
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-spring: cubic-bezier(0.22, 1, 0.36, 1);
    --header-height: 4.25rem;
  }
{% endstyle %}
