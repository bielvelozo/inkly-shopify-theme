<div class="bento section-spacing">
  <div class="section-heading">
    <h2 class="reveal">{{ section.settings.heading }}</h2>
    {% if section.settings.text != blank %}
      <p class="reveal">{{ section.settings.text }}</p>
    {% endif %}
  </div>

  <ul class="bento__grid" role="list">
    {% for block in section.blocks %}
      {%- liquid
        assign paper = block.settings.paper
        assign visual = block.settings.visual
      -%}
      <li
        class="bento__tile bento__tile--{{ block.settings.size }} paper paper--{{ paper }} reveal"
        data-reveal-stagger
        {{ block.shopify_attributes }}
      >
        <div class="bento__copy">
          <h3 class="bento__title">{{ block.settings.title }}</h3>
          {% if block.settings.text != blank %}
            <p class="bento__text">{{ block.settings.text }}</p>
          {% endif %}
          {% if block.settings.link_label != blank %}
            <a class="link-arrow bento__link" href="{{ block.settings.link }}">
              {{- block.settings.link_label -}}
              {{ 'icon-arrow-right.svg' | inline_asset_content }}
            </a>
          {% endif %}
        </div>

        {% case visual %}
          {% when 'editor' %}
            <div class="bento-editor" aria-hidden="true">
              <div class="bento-editor__card">
                <span class="bento-editor__line">{{ block.settings.sample }}</span><span class="bento-editor__caret"></span>
              </div>
              <div class="bento-editor__tools">
                <span class="bento-editor__tool is-active">{{ 'icon-step-edit.svg' | inline_asset_content }}{{ 'sections.bento.tool_text' | t }}</span>
                <span class="bento-editor__tool">{{ 'icon-upload.svg' | inline_asset_content }}{{ 'sections.bento.tool_photo' | t }}</span>
                <span class="bento-editor__tool"><b>Aa</b>{{ 'sections.bento.tool_font' | t }}</span>
                <span class="bento-editor__tool"><i class="bento-editor__dots"></i>{{ 'sections.bento.tool_color' | t }}</span>
              </div>
            </div>
          {% when 'quality' %}
            <div class="bento-quality" aria-hidden="true">
              <p class="bento-quality__row bento-quality__row--warn">
                <span class="bento-quality__icon">{{ 'icon-alert.svg' | inline_asset_content }}</span>
                <span><b>{{ 'sections.bento.quality_low' | t }}</b> 92 DPI</span>
              </p>
              <p class="bento-quality__row bento-quality__row--ok">
                <span class="bento-quality__icon">{{ 'icon-check.svg' | inline_asset_content }}</span>
                <span><b>{{ 'sections.bento.quality_ok' | t }}</b> 300 DPI</span>
              </p>
            </div>
          {% when 'order' %}
            <div class="bento-order" aria-hidden="true">
              <div class="bento-order__thumb">
                {% if block.settings.image %}
                  {{ block.settings.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '', widths: '120, 240' }}
                {% endif %}
              </div>
              <div class="bento-order__lines">
                <span class="bento-order__line"></span>
                <span class="bento-order__line bento-order__line--short"></span>
                <span class="tag tag--mint bento-order__tag">{{ 'sections.bento.order_tag' | t }}</span>
              </div>
            </div>
          {% when 'timeline' %}
            <ol class="bento-timeline" aria-hidden="true">
              <li>{{ 'sections.bento.step_print' | t }}</li>
              <li>{{ 'sections.bento.step_pack' | t }}</li>
              <li>{{ 'sections.bento.step_ship' | t }}</li>
            </ol>
          {% when 'image' %}
            {% if block.settings.image %}
              <div class="bento__image">
                {{
                  block.settings.image
                  | image_url: width: 1000
                  | image_tag:
                    loading: 'lazy',
                    widths: '320, 480, 640, 800, 1000',
                    sizes: '(min-width: 990px) 25vw, 90vw',
                    alt: block.settings.image.alt
                }}
              </div>
            {% endif %}
        {% endcase %}
      </li>
    {% endfor %}
  </ul>
</div>

{% stylesheet %}
  .bento__grid {
    display: grid;
    gap: clamp(0.75rem, 0.5rem + 0.8vw, 1.25rem);
    padding: 0;
    list-style: none;
  }

  .bento__tile {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 15rem;
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    overflow: hidden;
    border-radius: var(--radius-card);
  }

  .bento__copy {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: start;
    gap: 0.5rem;
    max-width: 26rem;
  }

  .bento__title {
    font-family: var(--font-display--family);
    font-weight: 800;
    font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.85rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .bento__text {
    color: color-mix(in srgb, currentcolor 80%, transparent);
  }

  .bento__link {
    margin-top: 0.35rem;
  }

  .bento__image {
    position: absolute;
    inset: 0;
  }

  .bento__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bento__tile:has(.bento__image) .bento__copy {
    margin-top: auto;
    padding: 1rem 1.15rem;
    border-radius: 1.1rem;
    background: rgb(255 255 255 / 0.92);
    color: var(--color-foreground);
    box-shadow: var(--shadow-soft);
  }

  .bento-editor {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }

  .bento-editor__card {
    display: flex;
    align-items: center;
    min-width: min(100%, 17rem);
    padding: 1.1rem 1.25rem;
    border-radius: 1.1rem;
    background: var(--color-background);
    box-shadow: var(--shadow-lift);
    font-family: var(--font-display--family);
    font-weight: 800;
    font-size: clamp(1.4rem, 1.1rem + 1vw, 2rem);
    letter-spacing: -0.035em;
    color: var(--color-accent);
    transform: rotate(-2deg);
  }

  .bento-editor__caret {
    width: 3px;
    height: 1.1em;
    margin-left: 3px;
    border-radius: 2px;
    background: var(--color-foreground);
    animation: caret-blink 1.1s steps(2, start) 8;
  }

  @keyframes caret-blink {
    to {
      visibility: hidden;
    }
  }

  .bento-editor__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0.4rem;
    border-radius: 999px;
    background: var(--color-foreground);
    color: var(--color-background);
  }

  .bento-editor__tool {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .bento-editor__tool.is-active {
    background: var(--color-lemon);
    color: var(--color-foreground);
  }

  .bento-editor__tool svg {
    width: 1rem;
    height: 1rem;
  }

  .bento-editor__dots {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    background: conic-gradient(var(--color-pink) 0 33%, var(--color-mint) 0 66%, var(--color-accent) 0);
  }

  .bento-quality {
    display: grid;
    gap: 0.6rem;
  }

  .bento-quality__row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.7rem 0.9rem;
    border-radius: 0.9rem;
    background: var(--color-background);
    box-shadow: var(--shadow-soft);
    font-size: 0.92rem;
  }

  .bento-quality__row--warn {
    transform: rotate(-1.5deg) translateX(-0.3rem);
  }

  .bento-quality__row--ok {
    margin-left: 1.5rem;
    transform: rotate(1deg);
  }

  .bento-quality__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
  }

  .bento-quality__row--warn .bento-quality__icon {
    background: #ffe1e6;
    color: var(--color-danger);
  }

  .bento-quality__row--ok .bento-quality__icon {
    background: var(--color-mint);
    color: var(--color-success);
  }

  .bento-quality__icon svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  .bento-order {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.8rem;
    border-radius: 1.1rem;
    background: var(--color-background);
    box-shadow: var(--shadow-lift);
    transform: rotate(1.5deg);
  }

  .bento-order__thumb {
    flex: none;
    width: 4.5rem;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 0.7rem;
    background: var(--color-surface);
  }

  .bento-order__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bento-order__lines {
    display: grid;
    flex: 1;
    gap: 0.45rem;
    justify-items: start;
  }

  .bento-order__line {
    width: 100%;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--color-surface);
  }

  .bento-order__line--short {
    width: 60%;
  }

  .bento-timeline {
    display: flex;
    gap: 0.4rem;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .bento-timeline li {
    counter-increment: step;
    display: grid;
    flex: 1;
    gap: 0.35rem;
    padding: 0.7rem;
    border-radius: 0.9rem;
    background: rgb(255 255 255 / 0.14);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.22);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .bento-timeline li::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: var(--color-lemon);
    color: var(--color-foreground);
    font-size: 0.8rem;
    font-weight: 800;
  }

  @media (min-width: 750px) {
    .bento__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .bento__tile--large,
    .bento__tile--wide {
      grid-column: span 2;
    }
  }

  @media (min-width: 990px) {
    .bento__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: minmax(16rem, auto);
    }

    .bento__tile--large {
      grid-column: span 2;
      grid-row: span 2;
    }

    .bento__tile--wide {
      grid-column: span 2;
    }

    .bento__tile--large .bento-editor {
      margin-bottom: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.bento",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:labels.text"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "t:general.bento_tile",
      "settings": [
        {
          "type": "select",
          "id": "size",
          "label": "t:labels.tile_size",
          "options": [
            { "value": "small", "label": "t:options.tile_size.small" },
            { "value": "wide", "label": "t:options.tile_size.wide" },
            { "value": "large", "label": "t:options.tile_size.large" }
          ],
          "default": "small"
        },
        {
          "type": "select",
          "id": "paper",
          "label": "t:labels.paper",
          "options": [
            { "value": "dots", "label": "t:options.paper.dots" },
            { "value": "stripes", "label": "t:options.paper.stripes" },
            { "value": "gingham", "label": "t:options.paper.gingham" },
            { "value": "cobalt", "label": "t:options.paper.cobalt" },
            { "value": "ink", "label": "t:options.paper.ink" },
            { "value": "tissue", "label": "t:options.paper.tissue" }
          ],
          "default": "tissue"
        },
        {
          "type": "select",
          "id": "visual",
          "label": "t:labels.tile_visual",
          "options": [
            { "value": "none", "label": "t:options.tile_visual.none" },
            { "value": "editor", "label": "t:options.tile_visual.editor" },
            { "value": "quality", "label": "t:options.tile_visual.quality" },
            { "value": "order", "label": "t:options.tile_visual.order" },
            { "value": "timeline", "label": "t:options.tile_visual.timeline" },
            { "value": "image", "label": "t:options.tile_visual.image" }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:labels.text"
        },
        {
          "type": "text",
          "id": "sample",
          "label": "t:labels.tile_sample",
          "default": "For Grandpa"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:labels.button_label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.button_link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.bento"
    }
  ]
}
{% endschema %}
