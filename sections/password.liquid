{% comment %}
  Landing page shown while the store is password protected.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

{{ 'password.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'password.title' | t
  endif
-%}

<div class="password paper paper--dots full-width">
  <div class="password__inner">
    <div class="password__card">
      <p class="password__brand display">{{ shop.name | split: ' ' | first }}</p>
      <h1 class="password__title">{{ heading }}</h1>

      {% if shop.password_message != blank %}
        <p class="password__text">{{ shop.password_message }}</p>
      {% elsif section.settings.text != blank %}
        <div class="password__text">{{ section.settings.text }}</div>
      {% endif %}

      {% form 'storefront_password', class: 'password__form' %}
        {% if form.errors %}
          <div class="password__error" role="alert">{{ form.errors | default_errors }}</div>
        {% endif %}

        <label class="field__label" for="PasswordInput">{{ 'password.password' | t }}</label>
        <div class="password__row">
          <input
            class="password__input"
            type="password"
            name="password"
            id="PasswordInput"
            autocomplete="current-password"
            enterkeyhint="go"
            required
          >
          <button class="button" type="submit">{{ 'password.enter' | t }}</button>
        </div>
      {% endform %}

      {% if section.settings.build_link != blank %}
        <a class="link-arrow password__build-link" href="{{ section.settings.build_link }}">
          {{- 'password.build_link' | t -}}
          {{ 'icon-arrow-right.svg' | inline_asset_content }}
        </a>
      {% endif %}
    </div>

    {% if section.settings.image %}
      <div class="password__visual">
        <div class="password__photo">
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              widths: '480, 720, 960, 1200',
              sizes: '(min-width: 990px) 34vw, 80vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: section.settings.image.alt
          }}
        </div>
        <span class="tag password__tag">{{ 'password.tag' | t }}</span>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "t:general.password",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text"
    },
    {
      "type": "url",
      "id": "build_link",
      "label": "t:labels.build_page"
    }
  ]
}
{% endschema %}
