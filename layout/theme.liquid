<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {%- liquid
      assign body_font = settings.type_primary_font
      assign body_font_weight = body_font.weight | append: ''
      assign body_font_bundled = false
      if body_font.family == 'Archivo' and body_font_weight == '400' and body_font.style == 'normal'
        assign body_font_bundled = true
      endif
    -%}

    {% # Inlined CSS Variables %}
    {% render 'css-variables', body_font_bundled: body_font_bundled %}

    {{ 'archivo-expanded-800.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {%- if body_font_bundled -%}
      {{ 'archivo-400.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {%- else -%}
      {{ body_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {%- endif %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    <script>
      window.theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }}
        },
        cartType: {{ settings.cart_type | json }},
        currency: {{ cart.currency.iso_code | json }},
        dataLayer: {{ settings.analytics_datalayer | json }}
      };
      document.documentElement.classList.add('is-dressing');
      setTimeout(() => document.documentElement.classList.remove('is-dressing'), 4500);
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('js-motion');
        setTimeout(() => {
          if (!window.theme.motionReady) document.documentElement.classList.remove('js-motion');
        }, 3000);
      }
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body>
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% if settings.cart_type == 'drawer' %}
      {% section 'cart-drawer' %}
    {% endif %}
  </body>
</html>
