{% comment %}
  Cart page. Uses the same snippets as the drawer, so it works without
  JavaScript and when the theme setting switches the cart to a page.
{% endcomment %}

{{ 'cart.css' | asset_url | stylesheet_tag }}

<div class="section-spacing">
  <h1>{{ 'cart.title' | t }}</h1>
</div>

{% if cart.item_count > 0 %}
  <div class="cart-page">
    <div class="cart-page__main">
      {% render 'free-shipping-bar' %}
      {% render 'cart-items' %}
      {% render 'cart-upsell' %}
    </div>
    <aside class="cart-page__aside">
      {% render 'cart-summary' %}
    </aside>
  </div>
{% else %}
  <div class="cart-page__empty">
    <p>{{ 'cart.empty' | t }}</p>
    <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue_shopping' | t }}</a>
  </div>
{% endif %}

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
