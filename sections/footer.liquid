<footer class="footer paper paper--ink full-width">
  <div class="footer__inner">
    <div class="footer__top">
      <div class="footer__intro">
        <p class="footer__pitch display">{{ section.settings.heading }}</p>
        {% if section.settings.button_label != blank %}
          <a class="button footer__cta" href="{{ section.settings.button_link }}">
            {{ section.settings.button_label }}
            {{ 'icon-arrow-right.svg' | inline_asset_content }}
          </a>
        {% endif %}
      </div>

      <div class="footer__columns">
        {% if section.settings.menu.links.size > 0 %}
          <nav class="footer__column" aria-labelledby="FooterMenu-{{ section.id }}">
            <h2 class="footer__title" id="FooterMenu-{{ section.id }}">{{ section.settings.menu_heading | default: section.settings.menu.title }}</h2>
            <ul role="list">
              {% for link in section.settings.menu.links %}
                <li>{{ link.title | link_to: link.url }}</li>
              {% endfor %}
            </ul>
          </nav>
        {% endif %}

        <div class="footer__column footer__newsletter">
          <h2 class="footer__title">{{ 'footer.newsletter_title' | t }}</h2>
          {% form 'customer', class: 'footer__form', id: 'FooterNewsletter' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {% if form.posted_successfully? %}
              <p class="footer__form-note" role="status">{{ 'footer.newsletter_success' | t }}</p>
            {% else %}
              <label class="visually-hidden" for="FooterEmail">{{ 'footer.newsletter_label' | t }}</label>
              <div class="footer__field">
                <input
                  id="FooterEmail"
                  type="email"
                  name="contact[email]"
                  autocomplete="email"
                  placeholder="{{ 'footer.newsletter_label' | t }}"
                  required
                >
                <button type="submit" aria-label="{{ 'footer.newsletter_submit' | t }}">
                  {{- 'icon-arrow-right.svg' | inline_asset_content -}}
                </button>
              </div>
              {% if form.errors %}
                <p class="footer__form-note" role="alert">{{ form.errors | default_errors }}</p>
              {% endif %}
            {% endif %}
          {% endform %}
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      {% if section.settings.notice != blank %}
        <p class="footer__notice">{{ section.settings.notice }}</p>
      {% endif %}

      <div class="footer__legal">
        <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}</span>
        {% if section.settings.show_payment_icons %}
          <ul class="footer__payment" role="list" aria-label="{{ 'footer.payment_methods' | t }}">
            {% for type in shop.enabled_payment_types %}
              <li>{{ type | payment_type_svg_tag }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </div>
  </div>

  <p class="footer__wordmark display" aria-hidden="true">{{ shop.name | split: ' ' | first }}</p>
</footer>

{% stylesheet %}
  .footer {
    position: relative;
    overflow: hidden;
    margin-top: clamp(3rem, 2rem + 4vw, 6rem);
    border-radius: clamp(1.75rem, 1rem + 2vw, 3rem) clamp(1.75rem, 1rem + 2vw, 3rem) 0 0;
    font-size: 0.95rem;
  }

  .footer__inner {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4.5rem);
    width: min(calc(var(--page-width) - var(--page-margin) * 2), calc(100% - var(--page-margin) * 2));
    margin-inline: auto;
    padding-top: clamp(3rem, 2rem + 4vw, 5.5rem);
  }

  .footer a {
    color: inherit;
    text-decoration: none;
  }

  .footer a:hover {
    text-decoration: underline;
  }

  .footer__top {
    display: grid;
    gap: 2.5rem;
  }

  .footer__intro {
    display: grid;
    justify-items: start;
    gap: 1.5rem;
  }

  .footer__pitch {
    max-width: 14ch;
    font-size: clamp(2rem, 1.2rem + 3vw, 3.6rem);
  }

  .footer__cta {
    --button-bg: var(--color-lemon);
    --button-fg: var(--color-foreground);
    --button-border: var(--color-lemon);
  }

  .footer__columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
    gap: 2rem;
  }

  .footer__title {
    margin-bottom: 1rem;
    font-family: var(--font-primary--family);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-background) 62%, transparent);
  }

  .footer__column ul {
    display: grid;
    gap: 0.6rem;
    padding: 0;
    list-style: none;
    font-size: 1.05rem;
  }

  .footer__field {
    display: flex;
    max-width: 24rem;
    padding: 0.3rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.1);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.18);
    transition: box-shadow 0.25s ease;
  }

  .footer__field:focus-within {
    box-shadow: inset 0 0 0 2px var(--color-lemon);
  }

  .footer__field input {
    flex: 1;
    min-width: 0;
    padding: 0.65rem 1rem;
    border: 0;
    background: transparent;
    color: inherit;
  }

  .footer__field input::placeholder {
    color: color-mix(in srgb, var(--color-background) 60%, transparent);
  }

  .footer__field input:focus-visible {
    outline: none;
  }

  .footer__field button {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: var(--color-lemon);
    color: var(--color-foreground);
    cursor: pointer;
    transition: transform 0.35s var(--ease-spring);
  }

  .footer__field button:hover {
    transform: rotate(-12deg) scale(1.06);
  }

  .footer__field svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .footer__form-note {
    margin-top: 0.75rem;
    color: color-mix(in srgb, var(--color-background) 75%, transparent);
  }

  .footer__bottom {
    display: grid;
    gap: 1rem;
    padding-block: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.14);
    color: color-mix(in srgb, var(--color-background) 70%, transparent);
    font-size: 0.875rem;
  }

  .footer__notice {
    max-width: 62ch;
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .footer__payment {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    list-style: none;
  }

  .footer__payment svg {
    width: 2.4rem;
    height: auto;
  }

  .footer__wordmark {
    margin-top: 0.5rem;
    margin-bottom: -0.16em;
    color: var(--color-pink);
    font-size: clamp(5rem, 24vw, 22rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
    text-align: center;
    white-space: nowrap;
    user-select: none;
  }

  @media (min-width: 990px) {
    .footer__top {
      grid-template-columns: 1.1fr 1fr;
      align-items: end;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    },
    {
      "type": "text",
      "id": "menu_heading",
      "label": "t:labels.menu_heading"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "textarea",
      "id": "notice",
      "label": "t:labels.footer_notice"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ]
}
{% endschema %}
