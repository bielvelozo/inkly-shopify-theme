{% doc %}
  Lists the cart lines with personalization, quantity controls and price.
  Quantity links work without JavaScript; the cart drawer intercepts them.
{% enddoc %}

{%- liquid
  assign preview_label = 'personalizer.property_preview' | t
  assign preview_key = '_' | append: preview_label
-%}

<ul class="cart-items" role="list">
  {% for item in cart.items %}
    {%- liquid
      assign preview = item.properties[preview_key]
      assign item_id = item.sku | default: item.variant_id
      assign line_price = item.final_price | divided_by: 100.0
      assign minus_one = item.quantity | minus: 1
      assign plus_one = item.quantity | plus: 1
    -%}
    {%- capture analytics -%}
      {"item_id": {{ item_id | json }}, "item_name": {{ item.product.title | json }}, "item_variant": {{ item.variant.title | json }}, "price": {{ line_price | json }}, "quantity": {{ item.quantity }}}
    {%- endcapture -%}
    <li class="cart-item" data-line-key="{{ item.key }}" data-quantity="{{ item.quantity }}" data-item="{{ analytics | strip | escape }}">
      <a class="cart-item__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
        {%- if preview != blank -%}
          <img src="{{ preview }}" alt="" width="160" height="160" loading="lazy">
        {%- elsif item.image -%}
          {{ item.image | image_url: width: 320 | image_tag: width: 160, height: 160, loading: 'lazy', alt: '' }}
        {%- endif -%}
      </a>

      <div class="cart-item__details">
        <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title }}</a>

        {% unless item.product.has_only_default_variant %}
          <p class="cart-item__meta">{{ item.variant.title }}</p>
        {% endunless %}

        {% if item.properties != empty %}
          <dl class="cart-item__properties">
            {% for property in item.properties %}
              {%- assign first_char = property.first | slice: 0 -%}
              {% if property.last != blank and first_char != '_' %}
                <div>
                  <dt>{{ property.first }}:</dt>
                  <dd>
                    {%- if property.last contains '/uploads/' -%}
                      <a href="{{ property.last }}" target="_blank" rel="noopener">{{ 'cart.view_file' | t }}</a>
                    {%- else -%}
                      {{ property.last }}
                    {%- endif -%}
                  </dd>
                </div>
              {% endif %}
            {% endfor %}
          </dl>
        {% endif %}

        {% for allocation in item.line_level_discount_allocations %}
          <p class="cart-item__discount">
            {{ allocation.discount_application.title }} (−{{ allocation.amount | money }})
          </p>
        {% endfor %}

        <div class="cart-item__actions">
          <div class="cart-quantity">
            <a
              class="cart-quantity__button"
              href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity={{ minus_one }}"
              role="button"
              data-cart-change
              data-key="{{ item.key }}"
              data-quantity="{{ minus_one }}"
              data-focus-id="minus-{{ item.key }}"
              aria-label="{{ 'cart.decrease' | t: product: item.product.title | escape }}"
            >
              {{- 'icon-minus.svg' | inline_asset_content -}}
            </a>
            <span class="cart-quantity__value" aria-label="{{ 'cart.quantity_of' | t: product: item.product.title, count: item.quantity | escape }}">
              {{- item.quantity -}}
            </span>
            <a
              class="cart-quantity__button"
              href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity={{ plus_one }}"
              role="button"
              data-cart-change
              data-key="{{ item.key }}"
              data-quantity="{{ plus_one }}"
              data-focus-id="plus-{{ item.key }}"
              aria-label="{{ 'cart.increase' | t: product: item.product.title | escape }}"
            >
              {{- 'icon-plus.svg' | inline_asset_content -}}
            </a>
          </div>

          <a
            class="cart-item__remove"
            href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity=0"
            role="button"
            data-cart-change
            data-key="{{ item.key }}"
            data-quantity="0"
            aria-label="{{ 'cart.remove_item' | t: product: item.product.title | escape }}"
          >
            {{- 'icon-trash.svg' | inline_asset_content -}}
          </a>
        </div>
      </div>

      <div class="cart-item__price">
        <span class="price">{{ item.final_line_price | money }}</span>
        {% if item.original_line_price > item.final_line_price %}
          <s>{{ item.original_line_price | money }}</s>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ul>
