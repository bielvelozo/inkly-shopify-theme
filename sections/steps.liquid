<div class="steps section-spacing">
  <h2 class="steps__heading">{{ section.settings.heading }}</h2>
  <ol class="steps__list" role="list">
    {% for block in section.blocks %}
      {%- assign icon = 'icon-step-' | append: block.settings.icon | append: '.svg' -%}
      <li class="steps__item" {{ block.shopify_attributes }}>
        <span class="steps__icon">{{ icon | inline_asset_content }}</span>
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.text }}</p>
      </li>
    {% endfor %}
  </ol>
</div>

{% stylesheet %}
  .steps__heading {
    text-align: center;
  }

  .steps__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    gap: 1.25rem;
    margin-top: 2.5rem;
    padding: 0;
    list-style: none;
  }

  .steps__item {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    padding: 2rem 1.5rem;
    border-radius: 20px;
    background: var(--color-surface);
    text-align: center;
  }

  .steps__icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-accent) 12%, var(--color-surface));
    color: var(--color-accent);
  }

  .steps__icon svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  .steps__item p {
    color: var(--color-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.steps",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:general.step",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:labels.icon",
          "options": [
            { "value": "pick", "label": "t:options.icon.pick" },
            { "value": "edit", "label": "t:options.icon.edit" },
            { "value": "box", "label": "t:options.icon.box" },
            { "value": "heart", "label": "t:options.icon.heart" }
          ],
          "default": "pick"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:labels.text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.steps"
    }
  ]
}
{% endschema %}
