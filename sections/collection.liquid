{% comment %}
  This section is used in the collection template to render collection page
  listing all products within a collection.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

{{ 'collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign papers = 'dots,stripes,gingham' | split: ','
  assign paper_index = collection.handle.size | modulo: 3
  assign paper = papers[paper_index]
-%}

<div class="collection-hero paper paper--{{ paper }} full-width under-header">
  <div class="collection-hero__inner">
    <h1 class="collection-hero__title">{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <div class="collection-hero__text">{{ collection.description }}</div>
    {% endif %}
    {% if section.settings.menu.links.size > 0 %}
      <nav class="collection-hero__chips" aria-label="{{ 'collections.browse' | t }}">
        {% for link in section.settings.menu.links %}
          {% if link.type == 'frontpage_link' %}{% continue %}{% endif %}
          <a
            class="collection-hero__chip"
            href="{{ link.url }}"
            {% if link.url == collection.url %}
              aria-current="page"
            {% endif %}
          >
            {{- link.title -}}
          </a>
        {% endfor %}
      </nav>
    {% endif %}
  </div>
</div>

<div class="collection section-spacing">
  {% paginate collection.products by 24 %}
    <div class="collection__toolbar">
      <p class="collection__count">{{ 'collections.product_count' | t: count: collection.products_count }}</p>
      <form class="collection__sort" method="get">
        <label class="collection__sort-label" for="SortBy-{{ section.id }}">{{ 'collections.sort_by' | t }}</label>
        <select id="SortBy-{{ section.id }}" name="sort_by" onchange="this.form.submit()">
          {% for option in collection.sort_options %}
            <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
          {% endfor %}
        </select>
        <noscript><button class="button button--small" type="submit">{{ 'collections.apply' | t }}</button></noscript>
      </form>
    </div>

    {% if collection.products.size > 0 %}
      <ul class="product-grid" role="list">
        {% for product in collection.products %}
          {%- liquid
            assign sizes = '(min-width: 990px) 22vw, 45vw'
          -%}
          <li class="reveal" data-reveal-stagger>
            {% render 'product-card', product: product, index: forloop.index, sizes: sizes %}
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="collection__empty">{{ 'collections.empty' | t }}</p>
    {% endif %}

    {% if paginate.pages > 1 %}
      <nav class="collection__pagination">{{ paginate | default_pagination }}</nav>
    {% endif %}
  {% endpaginate %}
</div>

{% schema %}
{
  "name": "t:general.collection",
  "class": "under-header-section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.collection_chips",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
