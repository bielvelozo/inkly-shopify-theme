<link rel="stylesheet" href="{{ 'section-testimonials.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'section-testimonials.css' | asset_url | stylesheet_tag }}</noscript>

<div class="testimonials paper paper--cobalt full-width">
  <scroll-carousel class="testimonials__inner section-spacing">
    <div class="testimonials__header">
      <div class="testimonials__intro">
        <h2 class="reveal">{{ section.settings.heading }}</h2>
        {% if section.settings.text != blank %}
          <p class="testimonials__lede reveal">{{ section.settings.text }}</p>
        {% endif %}
      </div>
      <div class="testimonials__controls">
        <button type="button" class="testimonials__control" data-prev aria-label="{{ 'sections.testimonials.previous' | t }}">
          {{- 'icon-chevron-left.svg' | inline_asset_content -}}
        </button>
        <button type="button" class="testimonials__control" data-next aria-label="{{ 'sections.testimonials.next' | t }}">
          {{- 'icon-chevron-right.svg' | inline_asset_content -}}
        </button>
      </div>
    </div>

    <div class="testimonials__line">
      <ul class="testimonials__track" role="list" data-track>
        {% for block in section.blocks %}
          <li class="testimonials__card" {{ block.shopify_attributes }}>
            <figure class="testimonials__tag">
              <p
                class="testimonials__stars"
                role="img"
                aria-label="{{ 'sections.testimonials.rating' | t: rating: block.settings.rating }}"
                style="--rating: {{ block.settings.rating }}"
              ></p>
              <blockquote class="testimonials__quote">{{ block.settings.quote }}</blockquote>
              <figcaption class="testimonials__author">
                <span class="testimonials__name">{{ block.settings.author }}</span>
                <span class="testimonials__meta">
                  {%- if block.settings.product != blank -%}{{ block.settings.product }} · {% endif -%}
                  {{ block.settings.location }}
                </span>
              </figcaption>
            </figure>
          </li>
        {% endfor %}
      </ul>
    </div>
  </scroll-carousel>
</div>

<script>{{ 'carousel.js' | inline_asset_content }}</script>

{% schema %}
{
  "name": "t:general.testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:labels.text"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "t:general.testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "t:labels.quote"
        },
        {
          "type": "text",
          "id": "author",
          "label": "t:labels.author"
        },
        {
          "type": "text",
          "id": "product",
          "label": "t:labels.testimonial_product"
        },
        {
          "type": "text",
          "id": "location",
          "label": "t:labels.location"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "t:labels.rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.testimonials"
    }
  ]
}
{% endschema %}
