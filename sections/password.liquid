{% comment %}
  Landing page shown while the store is password protected.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<div class="password full-width">
  {% if section.settings.image %}
    <div class="password__media">
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag:
          widths: '600, 900, 1200, 1600, 2000',
          sizes: '(min-width: 990px) 55vw, 100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: section.settings.image.alt
      }}
    </div>
  {% endif %}

  <div class="password__panel">
    <p class="password__brand heading">{{ shop.name }}</p>
    {%- liquid
      assign heading = section.settings.heading
      if heading == blank
        assign heading = 'password.title' | t
      endif
    -%}
    <h1 class="password__title">{{ heading }}</h1>

    {% if shop.password_message != blank %}
      <p class="password__text">{{ shop.password_message }}</p>
    {% elsif section.settings.text != blank %}
      <div class="password__text">{{ section.settings.text }}</div>
    {% endif %}

    {% form 'storefront_password', class: 'password__form' %}
      {% if form.errors %}
        <div class="password__error" role="alert">{{ form.errors | default_errors }}</div>
      {% endif %}

      <label class="field__label" for="PasswordInput">{{ 'password.password' | t }}</label>
      <div class="password__row">
        <input
          class="field__input"
          type="password"
          name="password"
          id="PasswordInput"
          autocomplete="current-password"
          required
        >
        <button class="button" type="submit">{{ 'password.enter' | t }}</button>
      </div>
    {% endform %}
  </div>
</div>

{% stylesheet %}
  .password {
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: 100svh;
    background: #f1ebe2;
  }

  .password__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 72% center;
  }

  .password__media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .password__panel {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: 2.5rem var(--page-margin) 3rem;
    background: var(--color-background);
  }

  .password__brand {
    font-size: 1.4rem;
  }

  .password__title {
    font-size: clamp(2rem, 1.4rem + 2.2vw, 3rem);
  }

  .password__text {
    max-width: 34rem;
    color: var(--color-muted);
  }

  .password__form {
    display: grid;
    gap: 0.5rem;
    max-width: 30rem;
    margin-top: 0.75rem;
  }

  .password__row {
    display: flex;
    gap: 0.6rem;
  }

  .password__row .field__input {
    flex: 1;
  }

  .password__error {
    padding: 0.6rem 0.8rem;
    border-radius: 10px;
    background: #fdecea;
    color: #a1251b;
    font-size: 0.9rem;
  }

  .password__error ul {
    margin: 0;
    padding-left: 1rem;
  }

  @media (min-width: 990px) {
    .password {
      grid-template-columns: 1.15fr 0.85fr;
      grid-template-rows: none;
    }

    .password__media {
      aspect-ratio: auto;
    }

    .password__panel {
      align-content: center;
      padding: 4rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text"
    }
  ]
}
{% endschema %}
