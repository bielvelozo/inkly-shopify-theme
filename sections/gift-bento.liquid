<link rel="stylesheet" href="{{ 'section-bento.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'section-bento.css' | asset_url | stylesheet_tag }}</noscript>

<div class="bento section-spacing">
  <div class="section-heading">
    <h2 class="reveal">{{ section.settings.heading }}</h2>
    {% if section.settings.text != blank %}
      <p class="reveal">{{ section.settings.text }}</p>
    {% endif %}
  </div>

  <ul class="bento__grid" role="list">
    {% for block in section.blocks %}
      {%- liquid
        assign paper = block.settings.paper
        assign visual = block.settings.visual
      -%}
      <li
        class="bento__tile bento__tile--{{ block.settings.size }}{% if visual == 'image' and block.settings.image %} bento__tile--image{% endif %} paper paper--{{ paper }} reveal"
        data-reveal-stagger
        {{ block.shopify_attributes }}
      >
        <div class="bento__copy">
          <h3 class="bento__title">{{ block.settings.title }}</h3>
          {% if block.settings.text != blank %}
            <p class="bento__text">{{ block.settings.text }}</p>
          {% endif %}
          {% if block.settings.link_label != blank %}
            <a class="link-arrow bento__link" href="{{ block.settings.link }}">
              {{- block.settings.link_label -}}
              {{ 'icon-arrow-right.svg' | inline_asset_content }}
            </a>
          {% endif %}
        </div>

        {% case visual %}
          {% when 'editor' %}
            <div class="bento-editor" aria-hidden="true">
              <div class="bento-editor__card">
                <span class="bento-editor__line">{{ block.settings.sample }}</span><span class="bento-editor__caret"></span>
              </div>
              <div class="bento-editor__tools">
                <span class="bento-editor__tool is-active">{{ 'icon-step-edit.svg' | inline_asset_content }}{{ 'sections.bento.tool_text' | t }}</span>
                <span class="bento-editor__tool">{{ 'icon-upload.svg' | inline_asset_content }}{{ 'sections.bento.tool_photo' | t }}</span>
                <span class="bento-editor__tool"><b>Aa</b>{{ 'sections.bento.tool_font' | t }}</span>
                <span class="bento-editor__tool"><i class="bento-editor__dots"></i>{{ 'sections.bento.tool_color' | t }}</span>
              </div>
            </div>
          {% when 'quality' %}
            <div class="bento-quality" aria-hidden="true">
              <p class="bento-quality__row bento-quality__row--warn">
                <span class="bento-quality__icon">{{ 'icon-alert.svg' | inline_asset_content }}</span>
                <span><b>{{ 'sections.bento.quality_low' | t }}</b> 92 DPI</span>
              </p>
              <p class="bento-quality__row bento-quality__row--ok">
                <span class="bento-quality__icon">{{ 'icon-check.svg' | inline_asset_content }}</span>
                <span><b>{{ 'sections.bento.quality_ok' | t }}</b> 300 DPI</span>
              </p>
            </div>
          {% when 'order' %}
            <div class="bento-order" aria-hidden="true">
              <div class="bento-order__thumb">
                {% if block.settings.image %}
                  {{ block.settings.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '', widths: '120, 240' }}
                {% endif %}
              </div>
              <div class="bento-order__lines">
                <span class="bento-order__line"></span>
                <span class="bento-order__line bento-order__line--short"></span>
                <span class="tag tag--mint bento-order__tag">{{ 'sections.bento.order_tag' | t }}</span>
              </div>
            </div>
          {% when 'timeline' %}
            <ol class="bento-timeline" aria-hidden="true">
              <li>{{ 'sections.bento.step_print' | t }}</li>
              <li>{{ 'sections.bento.step_pack' | t }}</li>
              <li>{{ 'sections.bento.step_ship' | t }}</li>
            </ol>
          {% when 'image' %}
            {% if block.settings.image %}
              <div class="bento__image">
                {{
                  block.settings.image
                  | image_url: width: 1000
                  | image_tag:
                    loading: 'lazy',
                    widths: '320, 480, 640, 800, 1000',
                    sizes: '(min-width: 990px) 25vw, 90vw',
                    alt: block.settings.image.alt
                }}
              </div>
            {% endif %}
        {% endcase %}
      </li>
    {% endfor %}
  </ul>
</div>

{% schema %}
{
  "name": "t:general.bento",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:labels.text"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "t:general.bento_tile",
      "settings": [
        {
          "type": "select",
          "id": "size",
          "label": "t:labels.tile_size",
          "options": [
            { "value": "small", "label": "t:options.tile_size.small" },
            { "value": "wide", "label": "t:options.tile_size.wide" },
            { "value": "large", "label": "t:options.tile_size.large" }
          ],
          "default": "small"
        },
        {
          "type": "select",
          "id": "paper",
          "label": "t:labels.paper",
          "options": [
            { "value": "dots", "label": "t:options.paper.dots" },
            { "value": "stripes", "label": "t:options.paper.stripes" },
            { "value": "gingham", "label": "t:options.paper.gingham" },
            { "value": "cobalt", "label": "t:options.paper.cobalt" },
            { "value": "ink", "label": "t:options.paper.ink" },
            { "value": "tissue", "label": "t:options.paper.tissue" }
          ],
          "default": "tissue"
        },
        {
          "type": "select",
          "id": "visual",
          "label": "t:labels.tile_visual",
          "options": [
            { "value": "none", "label": "t:options.tile_visual.none" },
            { "value": "editor", "label": "t:options.tile_visual.editor" },
            { "value": "quality", "label": "t:options.tile_visual.quality" },
            { "value": "order", "label": "t:options.tile_visual.order" },
            { "value": "timeline", "label": "t:options.tile_visual.timeline" },
            { "value": "image", "label": "t:options.tile_visual.image" }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:labels.text"
        },
        {
          "type": "text",
          "id": "sample",
          "label": "t:labels.tile_sample",
          "default": "For Grandpa"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:labels.button_label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.button_link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.bento"
    }
  ]
}
{% endschema %}
