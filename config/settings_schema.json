[
  {
    "name": "theme_info",
    "theme_name": "Inkly",
    "theme_version": "1.0.0",
    "theme_author": "Gabriel Velozo",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "archivo_n4",
        "label": "t:labels.body_font"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "surface_color",
        "default": "#F3F1FF",
        "label": "t:labels.surface"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#15123A",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "muted_color",
        "default": "#4D4970",
        "label": "t:labels.muted"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#2B44E6",
        "label": "t:labels.accent"
      },
      {
        "type": "color",
        "id": "border_color",
        "default": "#E1DEF3",
        "label": "t:labels.border"
      },
      {
        "type": "color",
        "id": "paper_pink",
        "default": "#FF9FCB",
        "label": "t:labels.paper_pink"
      },
      {
        "type": "color",
        "id": "paper_lemon",
        "default": "#FFE55C",
        "label": "t:labels.paper_lemon"
      },
      {
        "type": "color",
        "id": "paper_mint",
        "default": "#A6EBCB",
        "label": "t:labels.paper_mint"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 20,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 10
      }
    ]
  },
  {
    "name": "t:general.cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "t:labels.cart_type",
        "options": [
          {
            "value": "drawer",
            "label": "t:options.cart_type.drawer"
          },
          {
            "value": "page",
            "label": "t:options.cart_type.page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "header",
        "content": "t:labels.free_shipping"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "t:labels.free_shipping_threshold",
        "info": "t:info.free_shipping_threshold",
        "default": 50
      },
      {
        "type": "header",
        "content": "t:labels.upsell"
      },
      {
        "type": "text",
        "id": "cart_upsell_heading",
        "label": "t:labels.heading",
        "info": "t:info.upsell_heading"
      },
      {
        "type": "product_list",
        "id": "cart_upsell_products",
        "label": "t:labels.upsell_products",
        "info": "t:info.upsell_products",
        "limit": 8
      },
      {
        "type": "header",
        "content": "t:labels.pix"
      },
      {
        "type": "range",
        "id": "pix_discount_percent",
        "min": 0,
        "max": 20,
        "step": 1,
        "unit": "%",
        "label": "t:labels.pix_discount_percent",
        "info": "t:info.pix_discount_percent",
        "default": 0
      }
    ]
  },
  {
    "name": "t:general.analytics",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:info.analytics"
      },
      {
        "type": "checkbox",
        "id": "analytics_datalayer",
        "label": "t:labels.analytics_datalayer",
        "default": false
      }
    ]
  }
]
