{% comment %}
  This section is used in the search template to render search results for
  products, articles, and pages.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/search
{% endcomment %}

{{ 'collection.css' | asset_url | stylesheet_tag }}

{%- assign escaped_terms = search.terms | escape -%}

<div class="collection-hero search-hero paper paper--stripes full-width under-header">
  <div class="collection-hero__inner">
    <h1 class="collection-hero__title">{{ 'search.title' | t }}</h1>
    <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="SearchInput-{{ section.id }}">{{ 'search.label' | t }}</label>
      <input
        class="search-form__input"
        id="SearchInput-{{ section.id }}"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'search.placeholder' | t }}"
        autocomplete="off"
        enterkeyhint="search"
      >
      <input type="hidden" name="options[prefix]" value="last">
      <button class="button search-form__button" type="submit">{{ 'search.submit' | t }}</button>
    </form>
    {% if section.settings.menu.links.size > 0 %}
      <nav class="collection-hero__chips" aria-label="{{ 'collections.browse' | t }}">
        {% for link in section.settings.menu.links %}
          {% if link.type == 'frontpage_link' %}{% continue %}{% endif %}
          <a class="collection-hero__chip" href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      </nav>
    {% endif %}
  </div>
</div>

<div class="collection section-spacing">
  {% if search.performed and search.results_count > 0 %}
    <p class="collection__count" role="status">{{ 'search.results_for_html' | t: terms: escaped_terms, count: search.results_count }}</p>

    {% paginate search.results by 24 %}
      <ul class="product-grid" role="list">
        {% for result in search.results %}
          <li class="reveal" data-reveal-stagger>
            {% if result.object_type == 'product' %}
              {% render 'product-card', product: result, index: forloop.index %}
            {% else %}
              <a class="search-result" href="{{ result.url }}">
                <span class="search-result__type">{{ result.object_type | capitalize }}</span>
                <span class="search-result__title">{{ result.title }}</span>
                {% assign excerpt = result.content | default: result.excerpt | strip_html | truncatewords: 18 %}
                {% if excerpt != blank %}
                  <span class="search-result__text">{{ excerpt }}</span>
                {% endif %}
              </a>
            {% endif %}
          </li>
        {% endfor %}
      </ul>

      {% if paginate.pages > 1 %}
        <nav class="collection__pagination">{{ paginate | default_pagination }}</nav>
      {% endif %}
    {% endpaginate %}
  {% else %}
    <div class="search-empty">
      {% if search.performed %}
        <h2 class="search-empty__title" role="status">{{ 'search.no_results_html' | t: terms: escaped_terms }}</h2>
        <p class="search-empty__text">{{ 'search.no_results_hint' | t }}</p>
      {% else %}
        <h2 class="search-empty__title">{{ 'search.start' | t }}</h2>
      {% endif %}
    </div>

    {% assign suggestions = collections.all.products %}
    {% if suggestions.size > 0 %}
      <h2 class="search-empty__heading">{{ 'search.popular' | t }}</h2>
      <ul class="product-grid" role="list">
        {% for product in suggestions limit: 4 %}
          <li class="reveal" data-reveal-stagger>
            {% render 'product-card', product: product, index: forloop.index %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  {% endif %}
</div>

{% stylesheet %}
  .search-hero .collection-hero__inner {
    grid-template-columns: minmax(0, 1fr);
  }

  .search-form {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    width: min(100%, 36rem);
    padding: 0.35rem;
    border-radius: 999px;
    background: var(--color-background);
    outline: 2px solid var(--color-foreground);
    outline-offset: -2px;
    box-shadow: var(--shadow-lift);
  }

  .search-form:focus-within {
    outline: 3px solid var(--color-accent);
  }

  .search-form__input {
    flex: 1;
    min-width: 0;
    min-height: 3.25rem;
    padding: 0 1.1rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    font-size: 1.05rem;
    font-weight: 600;
  }

  .search-form__input:focus-visible {
    outline: none;
  }

  .search-form__input::-webkit-search-cancel-button {
    cursor: pointer;
  }

  .search-form__button {
    flex: none;
  }

  .search-empty {
    display: grid;
    gap: 0.5rem;
    padding-block: 0.5rem 1rem;
  }

  .search-empty__title {
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.4rem);
  }

  .search-empty__text {
    max-width: 38rem;
    color: var(--color-muted);
  }

  .search-empty__heading {
    font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.8rem);
  }

  .search-result {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    height: 100%;
    padding: 1.25rem;
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-border);
    text-decoration: none;
  }

  .search-result__type {
    color: var(--color-muted);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .search-result__title {
    font-family: var(--font-display--family);
    font-size: 1.25rem;
    font-weight: 800;
  }

  .search-result__text {
    color: var(--color-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "class": "under-header-section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.collection_chips",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
