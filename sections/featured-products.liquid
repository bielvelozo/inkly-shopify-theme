{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = collections.all
  endif
-%}

<div class="featured section-spacing">
  <div class="featured__header">
    <h2>{{ section.settings.heading }}</h2>
    <a class="featured__link" href="{{ source.url }}">
      {{- 'sections.featured_products.view_all' | t -}}
      {{ 'icon-arrow-right.svg' | inline_asset_content }}
    </a>
  </div>

  <ul class="product-grid" role="list">
    {% for product in source.products limit: section.settings.products_to_show %}
      <li>{% render 'product-card', product: product %}</li>
    {% endfor %}
  </ul>
</div>

{% stylesheet %}
  .featured__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 2rem;
  }

  .featured__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
  }

  .featured__link svg {
    width: 1.1rem;
    height: 1.1rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.featured_products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:labels.products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "t:general.featured_products"
    }
  ]
}
{% endschema %}
