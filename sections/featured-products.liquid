{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = collections.all
  endif
-%}

<div class="featured section-spacing">
  <div class="section-heading">
    <h2 class="reveal">{{ section.settings.heading }}</h2>
    <a class="link-arrow reveal" href="{{ source.url }}">
      {{- 'sections.featured_products.view_all' | t -}}
      {{ 'icon-arrow-right.svg' | inline_asset_content }}
    </a>
  </div>

  <ul class="product-grid" role="list">
    {% for product in source.products limit: section.settings.products_to_show %}
      <li class="reveal" data-reveal-stagger>{% render 'product-card', product: product, index: forloop.index %}</li>
    {% endfor %}
  </ul>
</div>

{% schema %}
{
  "name": "t:general.featured_products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:labels.products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "t:general.featured_products"
    }
  ]
}
{% endschema %}
